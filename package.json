{
  "name": "calmonkey",
  "version": "0.2.3",
  "description": "The CalMonkey command line tool: the calendar API from the terminal, for developers and their AI coding agents.",
  "keywords": [
    "calmonkey",
    "calendar",
    "calendar-api",
    "google-calendar",
    "microsoft-365",
    "icloud",
    "mcp",
    "ai",
    "agents",
    "cli"
  ],
  "homepage": "https://calmonkey.com/docs/ai",
  "bugs": {
    "url": "https://github.com/calmonkey/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calmonkey/cli.git"
  },
  "license": "MIT",
  "author": "Swixy Pty Ltd (https://calmonkey.com)",
  "type": "module",
  "bin": {
    "calmonkey": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run --exclude 'test/e2e/**'",
    "test:e2e": "npm run build && vitest run test/e2e",
    "skills:sync": "node scripts/sync-skills.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/reference.mjs --check",
    "reference": "node scripts/reference.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.0",
    "tiktoken": "^1.0.22",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
